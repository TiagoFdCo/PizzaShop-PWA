# Copie este arquivo para .env e ajuste se necessário.
# Ao rodar via docker-compose, os valores abaixo já batem com o serviço "postgres".

DATABASE_URL=postgresql+psycopg2://pizzashop:pizzashop@postgres:5432/pizzashop
JWT_SECRET=troque-este-valor-em-producao-para-uma-string-aleatoria-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Uma origem ou várias separadas por vírgula (não é JSON):
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mercado Pago (Checkout Pro) — pagamento real. Gere as credenciais de TESTE
# em https://www.mercadopago.com.br/developers/panel/app — veja o passo a
# passo em docs/fase4/P1-pagamento-concreto.md.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública do front e do backend (Mercado Pago usa pra redirecionar o
# navegador e chamar o webhook). Em dev local via docker-compose,
# BACKEND_URL precisa ser uma URL pública de verdade (ex. ngrok).
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:8000
