# Copie este arquivo para .env na raiz do projeto e ajuste se necessário.
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# VITE_API_URL define contra qual API o frontend fala:
#   - Modo A (mock/json-server): deixe COMENTADO ou remova. O front usa
#     http://localhost:3001 por padrão.
#   - Modo B (backend FastAPI):  deixe a linha abaixo ativa.
#
# Após criar ou alterar o .env, reinicie o `npm run dev` — o Vite só lê
# variáveis de ambiente na inicialização.

VITE_API_URL=http://localhost:8000
